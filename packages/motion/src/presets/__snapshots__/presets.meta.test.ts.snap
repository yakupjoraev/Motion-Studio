exports[`horizontal-scroll > emits a codegen fragment that names its imports 1`] = `
{
  "helpers": [
    {
      "name": "registerScrollTrigger",
      "source": "gsap.registerPlugin(ScrollTrigger)",
    },
  ],
  "hooks": [
    "const trackRef = useRef<HTMLDivElement>(null)",
    "useEffect(() => {
  const track = trackRef.current
  if (track === null) return
  const tween = gsap.to(track, {
    x: -1600,
    ease: 'none',
    scrollTrigger: {
      trigger: track.parentElement,
      pin: true,
      scrub: 1,
      end: '+=1600',
    },
  })
  return () => { tween.scrollTrigger?.kill(); tween.kill() }
}, [])",
  ],
  "imports": [
    {
      "default": "gsap",
      "from": "gsap",
    },
    {
      "from": "gsap/ScrollTrigger",
      "named": [
        "ScrollTrigger",
      ],
    },
    {
      "from": "react",
      "named": [
        "useEffect",
        "useRef",
      ],
    },
  ],
  "wrapper": {
    "props": {
      "ref": "{trackRef}",
    },
    "tag": "div",
  },
}
`;

