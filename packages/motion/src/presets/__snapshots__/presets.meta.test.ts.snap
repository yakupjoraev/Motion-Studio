exports[`text-scramble > emits a codegen fragment that names its imports 1`] = `
{
  "hooks": [
    "const scrambleRef = useRef<number | null>(null)",
    "const [scrambled, setScrambled] = useState(text)",
    "const startScramble = () => {
  const charset = "!<>-_\\\\/[]{}—=+*^?#"
  let frame = 0
  const run = () => {
    setScrambled(
      text
        .split('')
        .map((character, index) =>
          index < frame ? character : charset[Math.floor(Math.random() * charset.length)],
        )
        .join(''),
    )
    frame += 0.5
    if (frame <= text.length) scrambleRef.current = window.setTimeout(run, 40)
  }
  run()
}",
  ],
  "imports": [
    {
      "from": "react",
      "named": [
        "useRef",
        "useState",
      ],
    },
  ],
  "wrapper": {
    "props": {
      "aria-label": "{text}",
      "onPointerEnter": "{startScramble}",
    },
    "tag": "span",
  },
}
`;

exports[`tilt-3d > emits a codegen fragment that names its imports 1`] = `
{
  "css": ".ms-tilt-scene { perspective: 800px }
.ms-tilt { transform: rotateX(var(--ms-tilt-x, 0deg)) rotateY(var(--ms-tilt-y, 0deg)) }",
  "hooks": [
    "const tiltRef = useRef<HTMLDivElement>(null)",
  ],
  "imports": [
    {
      "from": "react",
      "named": [
        "useRef",
      ],
    },
  ],
  "wrapper": {
    "props": {
      "className": ""ms-tilt-scene"",
      "onPointerMove": "{(event) => {
  const element = tiltRef.current
  if (element === null) return
  const box = element.getBoundingClientRect()
  const px = (event.clientX - box.left) / box.width - 0.5
  const py = (event.clientY - box.top) / box.height - 0.5
  element.style.setProperty('--ms-tilt-y', \`\${px * 10}deg\`)
  element.style.setProperty('--ms-tilt-x', \`\${-py * 10}deg\`)
}}",
    },
    "tag": "div",
  },
}
`;

exports[`typewriter > emits a codegen fragment that names its imports 1`] = `
{
  "css": "@keyframes ms-caret { 50% { opacity: 0 } }
.ms-typewriter::after { content: '|'; animation: ms-caret 1000ms steps(1, end) infinite }",
  "hooks": [
    "const phrases = ["Design it.","Ship it."]",
    "const [typed, setTyped] = useState(phrases[0] ?? "")",
    "useEffect(() => {
  let phrase = 0
  let letter = 0
  const timer = window.setInterval(() => {
    const current = phrases[phrase] ?? ''
    letter = letter < current.length ? letter + 1 : 0
    if (letter === 0) phrase = (phrase + 1) % phrases.length
    setTyped(current.slice(0, letter))
  }, 70)
  return () => window.clearInterval(timer)
}, [])",
  ],
  "imports": [
    {
      "from": "react",
      "named": [
        "useEffect",
        "useState",
      ],
    },
  ],
  "wrapper": {
    "props": {
      "className": ""ms-typewriter"",
    },
    "tag": "span",
  },
}
`;

