{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // Next transforms JSX with its own SWC pipeline, so tsc must hand it through untouched.
    "jsx": "preserve",
    // Next generates .js config and instrumentation files that end up inside the program.
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
